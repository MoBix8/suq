generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  pinHash   String
  name      String
  role      String    @default("OWNER") // OWNER | ADMIN | SUPPLIER
  shop      Shop?
  supplier  Supplier?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Shop {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  city          String?
  subcity       String?
  phone         String?
  latitude      Float?
  longitude     Float?
  boundDeviceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  devices       Device[]
  sales         Sale[]
  customers     Customer[]
  products      ShopProduct[]
  creditEntries CreditEntry[]
  syncLogs      SyncLog[]
  orders        ShopOrder[]
}

model Supplier {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName          String
  latitude              Float?
  longitude             Float?
  deliveryBaseFee       Float    @default(0)
  deliveryPerKm         Float    @default(0)
  deliveryPerKg         Float    @default(0)
  deliveryPerCubicMeter Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  categories Category[]
  products   ProductLibraryItem[]
  listings   SupplierListing[]
  orders     ShopOrder[]
}

model Device {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceId       String
  appVersion     String?
  lastSeenAt     DateTime @default(now())
  lastServerTime DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([shopId, deviceId])
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Package {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  months      Int
  priceEtb    Float
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
}

model BankAccount {
  id            String   @id @default(cuid())
  code          String   @unique
  bankName      String
  accountName   String
  accountNumber String
  branch        String?
  instructions  String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  payments Payment[]
}

model Subscription {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  packageId String
  package   Package   @relation(fields: [packageId], references: [id])
  status    String    @default("PENDING") // PENDING | ACTIVE | EXPIRED | REJECTED
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payments Payment[]

  @@index([shopId, status])
  @@index([endsAt])
}

model Payment {
  id             String        @id @default(cuid())
  shopId         String
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  packageId      String
  package        Package       @relation(fields: [packageId], references: [id])
  bankAccountId  String
  bankAccount    BankAccount   @relation(fields: [bankAccountId], references: [id])
  amountEtb      Float
  transactionRef String        @unique
  note           String?
  status         String        @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote      String?
  submittedAt    DateTime      @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?

  @@index([status])
  @@index([shopId])
}

// ─── Product library ─────────────────────────────────────────────────────────

model Category {
  id         String    @id @default(cuid())
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  products ProductLibraryItem[]

  @@unique([supplierId, name])
  @@unique([supplierId, slug])
}

model ProductLibraryItem {
  id                  String    @id @default(cuid())
  sku                 String    @unique
  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                String
  nameAm              String?
  nameOr              String?
  barcode             String?
  unit                String    @default("pcs")
  defaultSellingPrice Float
  defaultBuyingPrice  Float?
  active              Boolean   @default(true)
  supplierId          String?
  supplier            Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shopProducts ShopProduct[]
  listings     SupplierListing[]

  @@index([categoryId])
  @@index([updatedAt])
}

model SupplierListing {
  id           String             @id @default(cuid())
  supplierId   String
  supplier     Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId    String
  product      ProductLibraryItem @relation(fields: [productId], references: [id], onDelete: Cascade)
  packName     String
  unitsPerPack Float
  weightKg     Float              @default(0)
  volumeCubicM Float              @default(0)
  bulkPrice    Float
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([supplierId, productId])
  @@index([supplierId, active])
}

model ShopOrder {
  id                 String          @id @default(cuid())
  shopId             String
  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status             String          @default("PENDING") // PENDING | ACCEPTED | REJECTED | READY | DELIVERED | CANCELLED
  subtotal           Float
  deliveryFee        Float
  total              Float
  deliveryDistanceKm Float?
  deliveryQuoted     Boolean         @default(false)
  shippingWeightKg   Float
  shippingVolumeM3   Float
  note               String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  items              ShopOrderItem[]

  @@index([shopId, createdAt])
  @@index([supplierId, status, createdAt])
}

model ShopOrderItem {
  id           String    @id @default(cuid())
  orderId      String
  order        ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  productName  String
  sku          String
  retailUnit   String
  packName     String
  unitsPerPack Float
  packageCount Int
  unitPrice    Float
  lineTotal    Float
  weightKg     Float
  volumeCubicM Float
}

// ─── Shop data (mirrored from devices) ───────────────────────────────────────

model ShopProduct {
  id                String              @id @default(cuid())
  shopId            String
  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  libraryItemId     String?
  libraryItem       ProductLibraryItem? @relation(fields: [libraryItemId], references: [id])
  name              String
  nameAm            String?
  nameOr            String?
  barcode           String?
  unit              String              @default("pcs")
  sellingPrice      Float
  buyingPrice       Float?
  stockQty          Float               @default(0)
  lowStockThreshold Float               @default(0)
  custom            Boolean             @default(false)
  deleted           Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([shopId, libraryItemId])
  @@index([shopId])
}

model Customer {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  creditBalance Float    @default(0)
  deleted       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales         Sale[]
  creditEntries CreditEntry[]

  @@index([shopId])
}

model Sale {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  receiptNo     String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String?
  subtotal      Float
  discount      Float     @default(0)
  total         Float
  paid          Float
  credit        Float     @default(0)
  cost          Float     @default(0)
  profit        Float     @default(0)
  paymentMethod String
  returned      Boolean   @default(false)
  soldAt        DateTime
  createdAt     DateTime  @default(now())

  items         SaleItem[]
  creditEntries CreditEntry[]

  @@unique([shopId, receiptNo])
  @@index([shopId, soldAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  unit      String
  qty       Float
  unitPrice Float
  unitCost  Float?
  lineTotal Float

  @@index([saleId])
}

model CreditEntry {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?    @relation(fields: [saleId], references: [id])
  type       String // CREDIT | PAYMENT | ADJUSTMENT
  amount     Float
  note       String?
  createdAt  DateTime @default(now())

  @@index([shopId, customerId])
}

model SyncLog {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceId  String?
  entity    String
  entityId  String
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}
